{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["DOM", "ESNext"],
        "module": "ESNext",
        "moduleResolution": "Bundler", // ✅ for Vite
        "jsx": "react-jsx", // ✅ enable JSX transform
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "baseUrl": ".",
        "paths": {
            "@generic/*": ["./*"],
            "@generic/src/*": ["./src/*"],
            "@generic/components/*": ["./src/components/*"]
        }
    },
    "include": ["src", "index.ts"],
    "exclude": ["node_modules", "dist"]
}
